<?xml version="1.0"?>
<package format="3">
  <name>m_detector</name>
  <version>0.0.1</version>
  <description>
    ROS 2 (Jazzy) port of M-detector (Moving Event Detection from LiDAR Point Streams).
    Original authors and license preserved.
  </description>

  <maintainer email="wu2020@connect.hku.hk">HuajieWu</maintainer>
  <!-- ROS2 Port Maintainer -->
  <maintainer email="konstantin@stud.tu-darmstadt.de">Konstantin Michels</maintainer>

  <license>GNUv2</license>

  <author email="wu2020@connect.hku.hk">HuajieWu</author>
  <author email="yhangli@connect.hku.hk">YihangLi</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <build_depend>libpcl-dev</build_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <exec_depend>libeigen3-dev</exec_depend>

  <build_depend>libtbb-dev</build_depend>
  <exec_depend>libtbb-dev</exec_depend>

  <exec_depend>livox_ros_driver2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
